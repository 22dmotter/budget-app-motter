// Draft only — not connected to a database. See docs/DATA_MODEL.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IncomeFrequency {
  weekly
  biweekly
  semimonthly
  monthly
}

enum CategoryGroup {
  giving
  saving
  debt
  needs
  wants
}

enum PayoffStrategy {
  snowball
  avalanche
  custom
}

enum DebtType {
  credit_card
  auto
  student
  mortgage
  personal
  medical
  other
}

enum PlanTier {
  free
  plus
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  displayName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  households   HouseholdMember[]
  leads        Lead[]
  subscription Subscription?
}

model Household {
  id        String   @id @default(uuid())
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   HouseholdMember[]
  budgets   Budget[]
  incomes   IncomeSource[]
  categories Category[]
  transactions Transaction[]
  debts     Debt[]
  plans     Plan[]
}

model HouseholdMember {
  id           String    @id @default(uuid())
  userId       String
  householdId  String
  role         String    @default("owner")
  user         User      @relation(fields: [userId], references: [id])
  household    Household @relation(fields: [householdId], references: [id])

  @@unique([userId, householdId])
}

model Budget {
  id          String    @id @default(uuid())
  householdId String
  name        String
  month       String
  currency    String    @default("USD")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  household   Household @relation(fields: [householdId], references: [id])
}

model IncomeSource {
  id           String           @id @default(uuid())
  householdId  String
  name         String
  amountCents  Int
  frequency    IncomeFrequency
  household    Household        @relation(fields: [householdId], references: [id])
}

model Category {
  id           String         @id @default(uuid())
  householdId  String
  name         String
  group        CategoryGroup
  plannedCents Int
  actualCents  Int            @default(0)
  household    Household      @relation(fields: [householdId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id           String    @id @default(uuid())
  householdId  String
  categoryId   String?
  date         DateTime  @db.Date
  description  String?
  amountCents  Int
  household    Household @relation(fields: [householdId], references: [id])
  category     Category? @relation(fields: [categoryId], references: [id])
}

model Debt {
  id                   String     @id @default(uuid())
  householdId          String
  name                 String
  type                 DebtType?
  startDate            DateTime   @db.Date
  startingCents        Int
  openingDate          DateTime   @db.Date
  openingCents         Int
  aprBps               Int
  minimumPaymentCents  Int
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  household            Household  @relation(fields: [householdId], references: [id])
  payments             DebtPayment[]
}

model DebtPayment {
  id            String   @id @default(uuid())
  debtId        String
  date          DateTime @db.Date
  paymentCents  Int
  balanceCents  Int
  note          String?
  debt          Debt     @relation(fields: [debtId], references: [id])
}

model Plan {
  id                 String         @id @default(uuid())
  householdId        String
  strategy           PayoffStrategy
  extraMonthlyCents  Int            @default(0)
  startMonth         String
  customOrder        Json?
  lumpSums           Json?
  household          Household      @relation(fields: [householdId], references: [id])
}

model Lead {
  id        String   @id @default(uuid())
  email     String
  name      String?
  source    String?
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model Subscription {
  id                 String   @id @default(uuid())
  userId             String   @unique
  tier               PlanTier @default(free)
  stripeCustomerId   String?
  stripeSubscriptionId String?
  status             String   @default("inactive")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id])
}

# Public API base URL (browser-visible).
# Leave unset / empty for the static GitHub Pages preview (dashboard shows "not connected yet").
# For local full-stack: NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: Stripe publishable key for future checkout UI
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# Optional lead-capture endpoint for the free-worksheet form (build-time).
# Leave unset on the GitHub Pages preview — the form will still offer the
# download and will not pretend emails were saved.
# Examples: http://localhost:4000/v1/leads  or a Formspree URL
# NEXT_PUBLIC_LEAD_ENDPOINT=
